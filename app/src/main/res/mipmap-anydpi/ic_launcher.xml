<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: solid brand-orange field behind the "m" over
     the circuit-board photograph. The letter is scaled to sit inside the
     66dp safe zone so no launcher mask clips it; the monochrome layer is
     the same "m" as a tintable glyph for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
